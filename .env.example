# Used by docker-compose.yml (root). Copy to .env and fill in before `docker compose up`.

POSTGRES_USER=turnup
POSTGRES_PASSWORD=turnup
POSTGRES_DB=turnup_db

# Required — no default, compose will refuse to start without it.
JWT_SECRET=change_me_to_a_long_random_value

# Origin(s) the server's CORS allow-list accepts (comma-separated). Should
# match wherever the client container is actually reachable from a browser.
CORS_ORIGIN=http://localhost:8080

# Baked into the client build at image-build time (Vite env vars are
# compile-time). Must be reachable from the *browser*, not just other
# containers — defaults to the server's published host port.
VITE_SERVER_URL=http://localhost:3000
