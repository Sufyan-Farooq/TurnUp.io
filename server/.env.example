DATABASE_URL="postgresql://username:password@localhost:5432/turnup_db?schema=public"

# Required — server refuses to start without this. Use a long random value in production.
JWT_SECRET="change_me_to_a_long_random_value"

PORT=3000

# Comma-separated list of allowed client origins for CORS (REST + Socket.IO).
# Falls back to http://localhost:5173 with a startup warning if unset.
CORS_ORIGIN="http://localhost:5173"
